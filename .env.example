# Required: PostgreSQL connection string (Supabase transaction pooler)
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Optional: Enables AI-powered features (Claude). Without this, heuristic fallbacks are used.
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Optional: GitHub PAT for seeding script. Increases rate limit from 60 to 5000 req/hr.
GITHUB_TOKEN="ghp_..."
